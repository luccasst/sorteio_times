# Cole os valores do AdSense (Conta → Anúncios → Unidades de anúncio).
# No Vercel: Project → Settings → Environment Variables.
# No GitHub Pages: Secrets do repositório + workflow (opcional).

VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_SLOT=xxxxxxxxxx

# E-mail de destino do formulário Contato (somente servidor, sem VITE_)
CONTATO_EMAIL=seu@email.com

# Chave gratuita em https://resend.com/api-keys (obrigatória para enviar)
RESEND_API_KEY=re_xxxxxxxx
